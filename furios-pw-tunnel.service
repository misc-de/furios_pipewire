[Unit]
Description=FuriOS Audio: PipeWire-Tunnel nach PulseAudio (Profil pw-tunnel)
After=pipewire.service pulseaudio.service
BindsTo=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/pipewire -c /usr/local/share/furios-audio/tunnel.conf
Restart=on-failure
RestartSec=2
Slice=session.slice

[Install]
WantedBy=default.target
