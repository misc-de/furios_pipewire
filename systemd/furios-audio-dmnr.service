[Unit]
# A bind mount does not survive a reboot - that is what makes it a safe way to
# change a dm-verity protected vendor file, and it is also why remembering the
# setting needs this unit. It lays the modified tuning file over again, but
# only if "furios-audio-dmnr set on" left its marker behind.
Description=Lay MediaTek's handsfree echo suppression over the vendor tuning file
Documentation=file:/usr/share/doc/furios-audio-pipewire/README.md
# The HAL reads that file when the audio stack starts, and the stack starts
# with the session. Before graphical.target, therefore - afterwards the mount
# would be in place but nothing would have read it until the next restart.
Before=graphical.target
# After the vendor image is there, and that is not a detail: a condition is
# checked when the unit is about to start, and this one was being checked in
# the same second android-mount.service BEGAN - 36 s before it finished. The
# unit was therefore skipped at every boot, silently and with a tidy journal
# line, while "furios-audio-dmnr status" said persistent=yes. Measured on
# 2026-09-19: condition unmet at 12:52:20, /android/vendor mounted at 12:52:56,
# and the setting that had been on since 18.9. was simply gone.
#
# Ordering only. On a device without that unit After= is satisfied trivially,
# and the condition below still decides whether there is anything to do.
After=android-mount.service

# No hard dependency on the path: on a device without this vendor file the
# tool exits 0 and nothing here should fail because of it.
ConditionPathExists=/android/vendor/etc/audio_param/AudioParamOptions.xml

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'd=/usr/local/bin/furios-audio-dmnr; test -x "$$d" || d=/usr/bin/furios-audio-dmnr; "$$d" boot'
# Undoing it on shutdown is pointless - the mount goes with the boot anyway -
# but it makes "systemctl stop" mean what it says.
ExecStop=/bin/sh -c 'd=/usr/local/bin/furios-audio-dmnr; test -x "$$d" || d=/usr/bin/furios-audio-dmnr; "$$d" off >/dev/null 2>&1 || true'

[Install]
WantedBy=multi-user.target
