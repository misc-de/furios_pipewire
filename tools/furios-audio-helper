# The only part of audioctl that needs root, with a vocabulary of five words.
#
# Everything else audioctl does runs as the user. What needs root is small and
# always the same: mask or unmask a handful of units in /etc/systemd/user,
# write or remove one systemd drop-in, and move one WirePlumber configuration
# file out of the way. That is all this can do.
#
# It used to be "sudo ln", "sudo rm", "sudo mv" and "sudo tee" from audioctl -
# which is to say, root for arbitrary commands with arbitrary arguments. This
# takes no paths from its caller at all: the unit names are checked against a
# list, and every file path is fixed here. pkexec authenticates the caller
# (see de.furios.audioctl.policy) before any of it runs.
set -u

# A seam for the tests, and nothing else: it is ignored outright when this runs
# as root, which is the only way it ever runs for real. Without it the five
# operations could only be exercised by letting them write into /etc.
PREFIX=""
[ "$(id -u)" != 0 ] && PREFIX=${FURIOS_AUDIO_HELPER_ROOT:-}

ETCU=$PREFIX/etc/systemd/user
DROPIN_DIR=$ETCU/pipewire.service.d
DROPIN=$DROPIN_DIR/50-furios-audio.conf

die() { printf 'furios-audio-helper: %s\n' "$*" >&2; exit 1; }

# Files can come from two places: installed from the source tree (/usr/local)
# or from the package (/usr).
first_existing() {
    for f in "$@"; do [ -e "$f" ] && { printf '%s' "$f"; return 0; }; done
    printf '%s' "$1"
}

# The units this is allowed to touch. A name that is not in here is refused
# rather than masked - masking is a symlink to /dev/null, and doing that to
# the wrong unit is how a phone stops booting.
known_unit() {
    case "$1" in
    pipewire-pulse.service|pipewire-pulse.socket|wireplumber.service|\
    pulseaudio.service|pulseaudio.socket) return 0 ;;
    esac
    return 1
}

wpconf_path() {
    p=$(first_existing "$PREFIX/usr/local/share/wireplumber/wireplumber.conf.d/50-droid.conf" \
                       "$PREFIX/usr/share/wireplumber/wireplumber.conf.d/50-droid.conf" \
                       "$PREFIX/usr/local/share/wireplumber/wireplumber.conf.d/50-droid.conf.off" \
                       "$PREFIX/usr/share/wireplumber/wireplumber.conf.d/50-droid.conf.off")
    printf '%s' "${p%.off}"
}

hal_conf_dir() {
    p=$(first_existing "$PREFIX/usr/local/share/furios-audio/pipewire-hal.conf" \
                       "$PREFIX/usr/share/furios-audio/pipewire-hal.conf")
    dirname "$p"
}

[ $# -ge 1 ] || die "nothing to do - see de.furios.audioctl.policy"
op=$1
shift

case "$op" in
mask)
    [ $# -ge 1 ] || die "mask needs a unit"
    for u in "$@"; do
        known_unit "$u" || die "refusing to mask \"$u\" - not one of ours"
    done
    for u in "$@"; do
        ln -sf /dev/null "$ETCU/$u" || die "could not mask $u"
    done
    ;;
unmask)
    [ $# -ge 1 ] || die "unmask needs a unit"
    for u in "$@"; do
        known_unit "$u" || die "refusing to unmask \"$u\" - not one of ours"
    done
    for u in "$@"; do
        # Only our own kind of mask, never a real file someone put there.
        if [ -L "$ETCU/$u" ] && [ "$(readlink "$ETCU/$u")" = /dev/null ]; then
            rm -f "$ETCU/$u" || die "could not unmask $u"
        fi
    done
    ;;
dropin-write)
    # No argument on purpose: the path is worked out here, not handed in.
    dir=$(hal_conf_dir)
    [ -e "$dir/pipewire-hal.conf" ] || die "no pipewire-hal.conf in $dir"
    mkdir -p "$DROPIN_DIR" || die "could not create $DROPIN_DIR"
    printf '[Service]\nExecStart=\nExecStart=/usr/bin/pipewire -c %s/pipewire-hal.conf\n' \
        "$dir" > "$DROPIN" || die "could not write $DROPIN"
    ;;
dropin-remove)
    rm -f "$DROPIN" || die "could not remove $DROPIN"
    ;;
wpconf)
    [ $# -eq 1 ] || die "wpconf needs on or off"
    conf=$(wpconf_path)
    case "$1" in
    on)  [ -e "$conf.off" ] && { mv "$conf.off" "$conf" || die "could not enable $conf"; } ;;
    off) [ -e "$conf" ]     && { mv "$conf" "$conf.off" || die "could not disable $conf"; } ;;
    *)   die "wpconf takes on or off, not \"$1\"" ;;
    esac
    ;;
*)
    die "unknown operation \"$op\""
    ;;
esac
exit 0
