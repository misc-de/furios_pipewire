[Unit]
Description=FuriOS Audio: gespeichertes Profil anwenden (Sicherheitsnetz)
# Runs before the sound stack so a test profile NEVER survives a reboot.
Before=pulseaudio.service pipewire.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
# From the package audioctl is in /usr/bin, from the source tree in
# /usr/local/bin. Naming only one of them made this do nothing at all.
#
# "audioctl boot" drops the test-mode marker and writes the configuration for
# the stored profile - masks, drop-in, droid monitor - for "standard" as much
# as for the others: a test profile leaves its masks behind, and applying the
# stored one is what discards them.
#
# It deliberately starts nothing. This unit runs Before= the units a profile
# switch would restart, so a restart asked for here waits for a job that is
# waiting for this unit to finish. That deadlock left the phone silent at
# every boot, with default.target never reached. The stack starts right after
# this, from the configuration written here.
ExecStart=/bin/sh -c 'a=/usr/local/bin/audioctl; test -x "$$a" || a=/usr/bin/audioctl; "$$a" boot'
# The same guard, for the same reason: this unit is the one that deadlocked.
# It writes files and starts nothing, so a minute is generous - and whatever
# goes wrong here, the boot continues.
TimeoutStartSec=60

[Install]
WantedBy=default.target
