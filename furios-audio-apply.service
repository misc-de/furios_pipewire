[Unit]
Description=FuriOS Audio: gespeichertes Profil anwenden (Sicherheitsnetz)
# Runs before the sound stack so a test profile NEVER survives a reboot.
Before=pulseaudio.service pipewire.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
# Drop the test-mode marker: after a reboot the persistent profile always wins.
ExecStart=/bin/sh -c 'rm -f /var/lib/furios-audio/profile.try'
# From the package audioctl is in /usr/bin, from the source tree in
# /usr/local/bin. Naming only one of them made this do nothing at all.
# The stored profile is applied unconditionally, "standard" included. It used
# to skip that case - and since a try profile leaves its masks and drop-in
# behind in the configuration, "audioctl try pw-hal" then survived the reboot
# it was supposed to be discarded by. Applying standard is what discards it.
ExecStart=/bin/sh -c 'a=/usr/local/bin/audioctl; test -x "$$a" || a=/usr/bin/audioctl; \
    p=$$(cat /var/lib/furios-audio/profile 2>/dev/null || echo standard); \
    "$$a" set "$$p" || "$$a" revert'

[Install]
WantedBy=default.target
