#!/bin/bash
# audioctl - Umschalten zwischen FuriOS-Standard-Audiostack und eigenen Profilen.
# Kein dpkg-Eigentum wird angefasst; alles laeuft ueber Masken in /etc/systemd/user
# und additive Units unter /usr/local. Rueckweg ist immer 'audioctl revert'.

set -u

STATE_DIR=/var/lib/furios-audio
STICKY=$STATE_DIR/profile
TRY=$STATE_DIR/profile.try
ETCU=/etc/systemd/user
DROPIN=$ETCU/pipewire.service.d/50-furios-audio.conf
LOCAL=/usr/local/share/furios-audio

PROFILES="standard pw-tunnel pw-hal"
DRY=0

die()  { printf 'audioctl: %s\n' "$*" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }
run()  { if [ "$DRY" = 1 ]; then printf '  [dry] %s\n' "$*"; else "$@"; fi; }

[ "$(id -un)" = root ] && die "bitte als Benutzer furios aufrufen, nicht als root (sudo wird intern verwendet)."

uctl() { systemctl --user "$@"; }

# --- Masken: Datei -> /dev/null anlegen bzw. entfernen -----------------------
mask()   { for u in "$@"; do run sudo ln -sf /dev/null "$ETCU/$u"; done; }
unmask() { for u in "$@"; do [ -L "$ETCU/$u" ] && [ "$(readlink "$ETCU/$u")" = /dev/null ] && run sudo rm -f "$ETCU/$u"; done; }

current_profile() {
    [ -r "$TRY" ]    && { printf '%s' "$(cat "$TRY")";    return; }
    [ -r "$STICKY" ] && { printf '%s' "$(cat "$STICKY")"; return; }
    printf 'standard'
}

# Was laeuft WIRKLICH? Die Vermerkdatei kann veralten - genau das hat beim
# ersten Anruftest in die Irre gefuehrt: status meldete pw-hal, tatsaechlich
# lief PulseAudio, und der Anruf pruefte den falschen Stack.
effective_profile() {
    if uctl is-active pulseaudio.service >/dev/null 2>&1; then
        if uctl is-active furios-pw-tunnel.service >/dev/null 2>&1; then
            printf 'pw-tunnel'
        else
            printf 'standard'
        fi
    elif uctl is-active pipewire-pulse.service >/dev/null 2>&1; then
        printf 'pw-hal'
    else
        printf 'unklar'
    fi
}

pulse_owner() {
    local s
    s=$(pactl info 2>/dev/null | sed -n 's/^Server Name: //p')
    [ -n "$s" ] && printf '%s' "$s" || printf 'nicht erreichbar'
}

# --- Vorbedingungen je Profil ----------------------------------------------
preflight() {
    case "$1" in
    standard) : ;;
    pw-tunnel)
        [ -e /usr/lib/aarch64-linux-gnu/pipewire-0.3/libpipewire-module-pulse-tunnel.so ] \
            || die "libpipewire-module-pulse-tunnel.so fehlt."
        [ -e "$LOCAL/tunnel.conf" ] || die "$LOCAL/tunnel.conf fehlt."
        ;;
    pw-hal)
        [ -e /usr/lib/aarch64-linux-gnu/spa-0.2/droid/libspa-droid.so ] \
            || die "SPA-Droid-Plugin noch nicht gebaut - Profil pw-hal ist bis dahin gesperrt."
        command -v wireplumber >/dev/null \
            || die "wireplumber nicht installiert (apt install wireplumber)."
        ;;
    *) die "unbekanntes Profil '$1'. Bekannt: $PROFILES" ;;
    esac
}

# --- Profile anwenden -------------------------------------------------------
apply() {
    local p=$1
    case "$p" in
    standard)
        run uctl stop furios-pw-tunnel.service 2>/dev/null
        run uctl disable furios-pw-tunnel.service 2>/dev/null
        # Maskieren stoppt einen LAUFENDEN Dienst nicht - erst stoppen,
        # sonst haelt pipewire-pulse weiter den Pulse-Socket.
        run uctl stop pipewire-pulse.service pipewire-pulse.socket 2>/dev/null
        run uctl stop wireplumber.service 2>/dev/null
        mask   pipewire-pulse.service pipewire-pulse.socket wireplumber.service
        unmask pulseaudio.service pulseaudio.socket
        run sudo rm -f "$DROPIN"
        run uctl daemon-reload
        # Ein gescheitertes pw-hal laesst pipewire in 'failed' zurueck - ohne
        # reset-failed bliebe die Kamera tot. Erst zuruecksetzen, dann starten.
        run uctl reset-failed pipewire.service 2>/dev/null
        run uctl restart pipewire.service
        # restart statt start: pipewire-pulse nimmt den Socket beim Beenden mit,
        # ein blosses start wuerde ihn nicht neu anlegen.
        run uctl restart pulseaudio.socket pulseaudio.service
        ;;
    pw-tunnel)
        # PulseAudio behaelt HAL und Pulse-Socket. PipeWire bekommt zusaetzlich
        # einen Tunnel-Sink. Telefonie bleibt unberuehrt.
        mask   pipewire-pulse.service pipewire-pulse.socket wireplumber.service
        unmask pulseaudio.service pulseaudio.socket
        run sudo rm -f "$DROPIN"
        run uctl daemon-reload
        run uctl start pulseaudio.socket pulseaudio.service
        run uctl enable --now furios-pw-tunnel.service
        ;;
    pw-hal)
        # PipeWire uebernimmt den HAL. PulseAudio muss weichen (HAL ist exklusiv).
        run uctl stop furios-pw-tunnel.service 2>/dev/null
        run uctl disable furios-pw-tunnel.service 2>/dev/null
        run uctl stop pulseaudio.service pulseaudio.socket
        mask   pulseaudio.service pulseaudio.socket
        unmask pipewire-pulse.service pipewire-pulse.socket wireplumber.service
        run sudo mkdir -p "$ETCU/pipewire.service.d"
        run sudo ln -sf "$LOCAL/pipewire-hal.conf.dropin" "$DROPIN"
        run uctl daemon-reload
        run uctl restart pipewire.service
        run uctl start wireplumber.service pipewire-pulse.socket pipewire-pulse.service
        ;;
    esac
}

# --- Verifikation: gibt es einen brauchbaren Sink? --------------------------
verify() {
    local i=0
    while [ $i -lt 15 ]; do
        if pactl list sinks short 2>/dev/null | grep -q .; then return 0; fi
        i=$((i+1)); sleep 1
    done
    return 1
}

# callaudiod und feedbackd halten dauerhafte Verbindungen zum Audioserver.
# Beim Profilwechsel wechselt der Server - danach findet callaudiod keine
# Karte mehr ("No suitable card found") und feedbackd scheitert an
# "Invalid state": kein Klingelton, nur noch Vibration. Beenden genuegt,
# D-Bus startet beide beim naechsten Aufruf neu.
restart_audio_clients() {
    local restarted=""
    pkill -x callaudiod 2>/dev/null && restarted="callaudiod"
    pkill -x feedbackd  2>/dev/null && restarted="${restarted:+$restarted, }feedbackd"
    [ -n "$restarted" ] && info "neu gestartet: $restarted (D-Bus aktiviert sie bei Bedarf)"
    return 0
}

switch_to() {
    local p=$1 mode=$2 prev
    prev=$(current_profile)
    preflight "$p"
    printf 'Wechsel: %s -> %s (%s)\n' "$prev" "$p" "$mode"
    apply "$p"
    [ "$DRY" = 1 ] && { echo "Trockenlauf beendet, nichts geaendert."; return 0; }

    restart_audio_clients

    if verify; then
        info "OK - Sink vorhanden: $(pactl list sinks short | awk '{print $2}' | paste -sd, -)"
        info "Pulse-Server: $(pulse_owner)"
        case "$mode" in
        sticky) mkdir -p "$STATE_DIR"; printf '%s\n' "$p" > "$STICKY"; rm -f "$TRY"
                info "persistent gesetzt (ueberlebt Neustart)" ;;
        try)    mkdir -p "$STATE_DIR"; printf '%s\n' "$p" > "$TRY"
                info "nur bis zum naechsten Neustart - danach wieder '$(cat "$STICKY" 2>/dev/null || echo standard)'" ;;
        esac
        [ "$p" != standard ] && info "Telefonie bitte pruefen: Anruf, Klingelton, Ohrmuschel/Lautsprecher."
        return 0
    fi

    printf 'FEHLGESCHLAGEN - kein Sink nach 15s. Falle auf standard zurueck.\n' >&2
    apply standard
    rm -f "$TRY"
    verify && info "standard wiederhergestellt." || info "ACHTUNG: auch standard liefert keinen Sink."
    return 1
}

# --- Anruf auf ein Bluetooth-Headset legen ---------------------------------
#
# callaudiod kennt nur Ohrmuschel und Lautsprecher. Fuer ein Headset muss
# zweierlei zusammenkommen: der Kopfhoerer im Freisprechprofil (damit ein
# SCO-Kanal steht) und die Telefonkarte auf die Route output-bluetooth_sco
# (damit der HAL BT_SCO=on schickt und den Sprachpfad dorthin legt).
#
# Die BT-Ports fehlen in der audio_policy-XML dieses Geraets - sie sind
# auskommentiert. Unser Plugin baut sie selbst; der HAL braucht die Datei
# nicht, er bekommt beim Routen nur den Geraetetyp.
bt_call() {
    local mode=$1 card sink_port src_port prof

    card=$(pactl list short cards 2>/dev/null | awk '/bluez_card/ {print $2; exit}')

    case "$mode" in
    on)
        if [ -z "$card" ]; then
            printf 'Kein Bluetooth-Geraet verbunden - nichts zu tun.\n' >&2
            return 1
        fi
        printf 'Bluetooth-Karte:    %s\n' "$card"

        # Freisprechprofil setzen, damit ein SCO-Kanal steht. Schlaegt es fehl,
        # geht es trotzdem weiter: der Kanal kann bereits stehen.
        if pactl set-card-profile "$card" headset-head-unit 2>/dev/null; then
            printf 'Kopfhoererprofil:   headset-head-unit\n'
        elif pactl set-card-profile "$card" headset-head-unit-cvsd 2>/dev/null; then
            printf 'Kopfhoererprofil:   headset-head-unit-cvsd (Schmalband)\n'
        else
            prof=$(pactl list cards 2>/dev/null | sed -n "/$card/,/^$/p" | sed -n 's/.*Active Profile: //p')
            printf 'ACHTUNG: Freisprechprofil laesst sich nicht setzen (aktiv: %s).\n' "${prof:-unbekannt}" >&2
            printf '         Ohne Freisprechprofil steht kein SCO-Kanal.\n' >&2
        fi
        sink_port=output-bluetooth_sco
        src_port=input-bluetooth_sco_headset
        ;;
    off)
        sink_port=output-earpiece
        src_port=input-builtin_mic
        [ -n "$card" ] && pactl set-card-profile "$card" a2dp-sink 2>/dev/null
        ;;
    *) die "bt-call braucht 'on' oder 'off'." ;;
    esac

    pactl set-sink-port   droid-sink   "$sink_port" 2>/dev/null \
        && printf 'Ausgang:            %s\n' "$sink_port" \
        || printf 'FEHLER: Ausgang %s liess sich nicht setzen.\n' "$sink_port" >&2
    pactl set-source-port droid-source "$src_port" 2>/dev/null \
        && printf 'Eingang:            %s\n' "$src_port" \
        || printf 'FEHLER: Eingang %s liess sich nicht setzen.\n' "$src_port" >&2

    # Gegenprobe an der Wirklichkeit, nicht am Wunsch.
    printf 'Tatsaechlich aktiv: %s / %s\n' \
        "$(pactl list sinks 2>/dev/null | sed -n '/Name: droid-sink/,/^$/p' | sed -n 's/.*Active Port: //p')" \
        "$(pactl list sources 2>/dev/null | sed -n '/Name: droid-source/,/^$/p' | sed -n 's/.*Active Port: //p')"

    # Im Anruf mischt callaudiod mit und setzt den Port gern zurueck. Nach
    # einigen Sekunden nachsehen und es einmal richten - sonst sucht man den
    # Fehler beim HAL, obwohl ihn jemand anders ueberschrieben hat.
    if [ "$mode" = on ]; then
        sleep 3
        now=$(pactl list sinks 2>/dev/null | sed -n '/Name: droid-sink/,/^$/p' | sed -n 's/.*Active Port: //p')
        if [ "$now" != "$sink_port" ]; then
            printf 'Nach 3 s stand der Ausgang auf "%s" - jemand hat umgeschaltet\n' "$now"
            printf '(sehr wahrscheinlich callaudiod). Setze noch einmal.\n'
            pactl set-sink-port droid-sink "$sink_port" 2>/dev/null
            sleep 2
            printf 'Jetzt: %s\n' "$(pactl list sinks 2>/dev/null | sed -n '/Name: droid-sink/,/^$/p' | sed -n 's/.*Active Port: //p')"
        fi
    fi

    [ "$mode" = on ] && printf 'Zurueck mit: audioctl bt-call off\n'
    return 0
}

usage() {
    cat <<EOF
audioctl - Audiostack umschalten

  audioctl status              aktuellen Zustand zeigen
  audioctl toggle              Schalter: standard <-> pw-hal (im Testmodus)
  audioctl list                Profile auflisten
  audioctl try <profil>        umschalten, faellt beim Neustart zurueck
  audioctl set <profil>        umschalten und persistent merken
  audioctl bt-call on|off      laufenden Anruf aufs Bluetooth-Headset legen
  audioctl revert              sofort zurueck auf standard
  audioctl verify              pruefen, ob ein Sink da ist

  --dry-run                    nur zeigen, was passieren wuerde

Profile:
  standard    FuriOS wie ausgeliefert: PulseAudio haelt den HAL, PipeWire nur Video
  pw-tunnel   wie standard, plus PipeWire-Tunnel-Sink (Telefonie unberuehrt)
  pw-hal      PipeWire haelt den HAL per SPA-Droid-Plugin (Wiedergabe, Aufnahme
              und Telefonie am Geraet bestaetigt)
EOF
}

status() {
    local eff rec
    eff=$(effective_profile)
    rec=$(current_profile)
    printf 'Profil (aktiv):     %s\n' "$eff"
    if [ "$eff" != "$rec" ]; then
        printf 'ACHTUNG:            vermerkt ist "%s" - das passt nicht zum laufenden System.\n' "$rec"
        printf '                    Mit "audioctl set %s" wieder in Einklang bringen.\n' "$eff"
    fi
    printf 'Profil (persistent):%s\n' " $(cat "$STICKY" 2>/dev/null || echo standard)"
    [ -r "$TRY" ] && printf 'Testmodus:          ja - faellt beim Neustart zurueck\n'
    printf 'Pulse-Server:       %s\n' "$(pulse_owner)"
    printf 'Sinks:              %s\n' "$(pactl list sinks short 2>/dev/null | awk '{print $2}' | paste -sd, - || echo keine)"
    printf '\nUnits:\n'
    for u in pulseaudio.service pipewire.service pipewire-pulse.service wireplumber.service furios-pw-tunnel.service; do
        printf '  %-28s %-10s %s\n' "$u" "$(uctl is-enabled "$u" 2>&1 | head -1)" "$(uctl is-active "$u" 2>&1 | head -1)"
    done
}

args=(); for a in "$@"; do [ "$a" = --dry-run ] && DRY=1 || args+=("$a"); done
set -- ${args+"${args[@]}"}
case "${1:-status}" in
    status) status ;;
    # Schalter: bewusst im Testmodus, damit ein Neustart immer zum
    # Auslieferungszustand zurueckfuehrt.
    toggle) if [ "$(effective_profile)" = pw-hal ]; then
                switch_to standard sticky
            else
                switch_to pw-hal try
            fi ;;
    list)   printf '%s\n' $PROFILES ;;
    try)    [ $# -ge 2 ] || die "Profil fehlt."; switch_to "$2" try ;;
    set)    [ $# -ge 2 ] || die "Profil fehlt."; switch_to "$2" sticky ;;
    bt-call) [ $# -ge 2 ] || die "bt-call braucht 'on' oder 'off'."; bt_call "$2" ;;
    revert) switch_to standard sticky ;;
    verify) verify && echo "OK - Sink vorhanden." || { echo "kein Sink." >&2; exit 1; } ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
