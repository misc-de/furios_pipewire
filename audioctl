#!/bin/bash
# SPDX-FileCopyrightText: Copyright (c) 2026 misc-de
# SPDX-License-Identifier: MIT
# audioctl - switch between the stock FuriOS audio stack and our own profiles.
# Nothing owned by dpkg is touched; everything works through masks in
# /etc/systemd/user and additive units under /usr/local. The way back is always
# 'audioctl revert'.

set -u

# Overridable so the tests can run the real dispatcher without writing into
# the state of the phone they are running on.
STATE_DIR=${AUDIOCTL_STATE_DIR:-/var/lib/furios-audio}
STICKY=$STATE_DIR/profile
TRY=$STATE_DIR/profile.try

# The profile written here decides what furios-audio-apply.service applies at
# the next login, and that runs audioctl again - so a state directory anyone
# can write to hands the audio stack to anyone on the machine. Found exactly
# that on the phone this was developed on: /var/lib/furios-audio at 1777 and
# profile at 0666. Create it narrow, and say so rather than trust a wide one.
state_dir_ready() {
    [ -d "$STATE_DIR" ] || { mkdir -p "$STATE_DIR" 2>/dev/null || return 1; chmod 0755 "$STATE_DIR" 2>/dev/null; }
    perms=$(stat -c %a "$STATE_DIR" 2>/dev/null) || return 0
    case "$perms" in
    *[2367])
        # Ours to fix, or somebody else's to know about.
        chmod o-w,g-w "$STATE_DIR" 2>/dev/null \
            || warn "$STATE_DIR is writable by others ($perms) - anyone on this device can choose the audio profile"
        ;;
    esac
    return 0
}

# Write one line into a state file, readable by all and writable by nobody
# else. Without the umask the file inherits whatever the caller had.
write_state() {
    _f=$1 _v=$2
    state_dir_ready || return 1
    ( umask 022; printf '%s\n' "$_v" > "$_f" ) || return 1
    chmod 0644 "$_f" 2>/dev/null
}
# systemd --user reads ~/.config/systemd/user BEFORE /etc/systemd/user, and
# WirePlumber reads ~/.config/wireplumber the same way. Everything audioctl
# changes therefore lives in the user's own configuration - which is why none
# of this needs root any more, and why there is no helper, no pkexec and no
# sudoers line left to get wrong.
USERCFG=${XDG_CONFIG_HOME:-$HOME/.config}
ETCU=${AUDIOCTL_ETCU:-$USERCFG/systemd/user}
DROPIN=$ETCU/pipewire.service.d/50-furios-audio.conf
WPUSER=${AUDIOCTL_WPCONF_DIR:-$USERCFG/wireplumber/wireplumber.conf.d}
WPOFF=$WPUSER/99-furios-droid-off.conf
# Files can come from two sources: installed from the source tree
# (/usr/local) or from the package (/usr). Both have to be found.
first_existing() {
    local f
    for f in "$@"; do [ -e "$f" ] && { printf '%s' "$f"; return 0; }; done
    printf '%s' "$1"
}
LOCAL=$(dirname "$(first_existing /usr/local/share/furios-audio/pipewire-hal.conf \
                                  /usr/share/furios-audio/pipewire-hal.conf)")

PROFILES="standard pw-tunnel pw-hal"
DRY=0
# Set by the "boot" command: write the configuration, start nothing. See uctl().
BOOT=0

die()  { printf 'audioctl: %s\n' "$*" >&2; exit 1; }
info() { printf '  %s\n' "$*"; }
warn() { printf 'audioctl: %s\n' "$*" >&2; }
run()  { if [ "$DRY" = 1 ]; then printf '  [dry] %s\n' "$*"; else "$@"; fi; }


# At boot furios-audio-apply.service runs Before= the very units a profile
# switch restarts - so asking systemd for that restart there waits for a job
# that is waiting for us. The deadlock held the entire session: pipewire never
# started, default.target never finished, and the phone came up silent with a
# masked PulseAudio, because a switch had got half-way through.
#
# Nothing needs starting at that point anyway. Only the configuration is
# written, and systemd starts the stack from it moments later. "--now" goes the
# same way: "enable" is configuration and stays, starting it here is not.
uctl() {
    if [ "$BOOT" = 1 ]; then
        case "$1" in
        start|stop|restart|reset-failed) return 0 ;;
        enable|disable)
            local verb=$1; shift
            [ "${1:-}" = --now ] && shift
            set -- "$verb" "$@" ;;
        esac
    fi
    systemctl --user "$@"
}

# --- the three things a profile switch changes ------------------------------
#
# None of them needs root: systemd and WirePlumber both look in the user's
# configuration first, so masking a unit, dropping in a different ExecStart and
# turning the droid monitor off all happen under $HOME.
#
# This used to be furios-audio-helper behind pkexec, with a sudo fallback for
# the boot-time safety net - and that fallback is why FuriOS shipping
# "furios ALL=(ALL) NOPASSWD:ALL" mattered to us at all. It does not any more.

# The units a profile switch is allowed to touch. Masking is a symlink to
# /dev/null, and doing that to the wrong unit is how a session stops coming up.
known_unit() {
    case "$1" in
    pipewire-pulse.service|pipewire-pulse.socket|wireplumber.service|\
    pulseaudio.service|pulseaudio.socket) return 0 ;;
    esac
    return 1
}

do_mask() {
    for u in "$@"; do
        known_unit "$u" || { warn "refusing to mask \"$u\" - not one of ours"; return 1; }
    done
    mkdir -p "$ETCU" || return 1
    for u in "$@"; do
        ln -sf /dev/null "$ETCU/$u" || { warn "could not mask $u"; return 1; }
    done
    return 0
}

do_unmask() {
    for u in "$@"; do
        known_unit "$u" || { warn "refusing to unmask \"$u\" - not one of ours"; return 1; }
    done
    for u in "$@"; do
        # Only our own kind of mask, never a real file someone put there.
        if [ -L "$ETCU/$u" ] && [ "$(readlink "$ETCU/$u")" = /dev/null ]; then
            rm -f "$ETCU/$u" || { warn "could not unmask $u"; return 1; }
        fi
    done
    return 0
}

mask()   { run do_mask "$@"; }
unmask() { run do_unmask "$@"; }

dropin_write() {
    [ -e "$LOCAL/pipewire-hal.conf" ] || { warn "no pipewire-hal.conf in $LOCAL"; return 1; }
    mkdir -p "$(dirname "$DROPIN")" || return 1
    printf '[Service]\nExecStart=\nExecStart=/usr/bin/pipewire -c %s/pipewire-hal.conf\n' \
        "$LOCAL" > "$DROPIN"
}

dropin_remove() { rm -f "$DROPIN"; }

# What an older version left in /etc, which we can no longer write and no
# longer need.
#
# systemd reads ~/.config/systemd/user first, but only for units that are
# actually there: a mask still sitting in /etc/systemd/user keeps masking, and
# a drop-in there keeps applying. So say so, once, with the command that clears
# it - rather than silently fighting a state we cannot reach.
LEGACY_ETCU=/etc/systemd/user
legacy_leftovers() {
    out=
    for u in pipewire-pulse.service pipewire-pulse.socket wireplumber.service \
             pulseaudio.service pulseaudio.socket; do
        if [ -L "$LEGACY_ETCU/$u" ] && [ "$(readlink "$LEGACY_ETCU/$u")" = /dev/null ]; then
            out="$out $LEGACY_ETCU/$u"
        fi
    done
    [ -e "$LEGACY_ETCU/pipewire.service.d/50-furios-audio.conf" ] \
        && out="$out $LEGACY_ETCU/pipewire.service.d/50-furios-audio.conf"
    for f in /usr/local/share/wireplumber/wireplumber.conf.d/50-droid.conf.off \
             /usr/share/wireplumber/wireplumber.conf.d/50-droid.conf.off; do
        [ -e "$f" ] && out="$out $f"
    done
    printf '%s' "${out# }"
}

warn_about_legacy() {
    left=$(legacy_leftovers)
    [ -z "$left" ] && return 0
    warn "an older version left system-wide state behind, and it still wins:"
    for f in $left; do warn "    $f"; done
    warn "  audioctl no longer needs root and cannot clear these itself. Once:"
    warn "    sudo audioctl migrate"
    return 0
}

# Clear exactly those leftovers, and nothing else. The only thing in audioctl
# that wants root, run once by hand.
migrate_legacy() {
    [ "$(id -u)" = 0 ] || die "run this one as root: sudo audioctl migrate"
    left=$(legacy_leftovers)
    [ -z "$left" ] && { info "nothing left over - already migrated"; return 0; }
    for f in $left; do
        case "$f" in
        "$LEGACY_ETCU"/*|*/wireplumber.conf.d/50-droid.conf.off) ;;
        *) warn "refusing to touch $f"; continue ;;
        esac
        if [ "${f%.off}" != "$f" ]; then
            run mv "$f" "${f%.off}" && info "restored ${f%.off}"
        else
            run rm -f "$f" && info "removed $f"
        fi
    done
    run systemctl --global daemon-reload 2>/dev/null
    info "done - the profile now lives under \$HOME and needs no root"
    return 0
}

# Is this one of ours? Everything that comes out of a state file goes through
# here first.
known_profile() {
    case " $PROFILES " in *" $1 "*) return 0 ;; esac
    return 1
}

# What the state files say - but never something that is not a profile.
#
# The content used to be passed on unread. A file that had been truncated, or
# written by an older version, or simply damaged, then reached preflight() and
# killed "audioctl boot" with "unknown profile" - the one command that runs at
# every boot and whose whole job is to leave the phone in a state that makes
# sound. Falling back to standard is what the rest of this file does whenever
# it does not know better; do it here too, and say so.
current_profile() {
    local p=""
    [ -r "$TRY" ]    && p=$(cat "$TRY"    2>/dev/null)
    [ -n "$p" ] || { [ -r "$STICKY" ] && p=$(cat "$STICKY" 2>/dev/null); }
    [ -n "$p" ] || { printf 'standard'; return; }
    if known_profile "$p"; then
        printf '%s' "$p"
    else
        warn "stored profile \"$p\" is not one of ours - using standard"
        printf 'standard'
    fi
}

# What is REALLY running? The state file can go stale - which is exactly what
# misled the first call test: status reported pw-hal while PulseAudio was
# actually running, and the call tested the wrong stack.
effective_profile() {
    if uctl is-active pulseaudio.service >/dev/null 2>&1; then
        if uctl is-active furios-pw-tunnel.service >/dev/null 2>&1; then
            printf 'pw-tunnel'
        else
            printf 'standard'
        fi
    elif uctl is-active pipewire-pulse.service >/dev/null 2>&1; then
        printf 'pw-hal'
    else
        printf 'unclear'
    fi
}

pulse_owner() {
    local s
    s=$(pactl info 2>/dev/null | sed -n 's/^Server Name: //p')
    [ -n "$s" ] && printf '%s' "$s" || printf 'not reachable'
}

# Does the plugin still match the installed PipeWire version?
#
# The plugin is built against a specific SPA interface. If a system update
# breaks it, pw-hal would go silent without a word - the auto-revert catches
# that, but a warning beforehand saves the search.
plugin_version_check() {
    local dir=/usr/lib/aarch64-linux-gnu/spa-0.2/droid built now
    [ -r "$dir/built-against" ] || return 0
    built=$(cat "$dir/built-against")
    now=$(pkg-config --modversion libpipewire-0.3 2>/dev/null)
    [ -n "$now" ] || now=$(pipewire --version 2>/dev/null | sed -n 's/.*libpipewire \([0-9.]*\).*/\1/p' | head -1)
    [ -n "$now" ] || return 0
    if [ "$built" != "$now" ]; then
        printf 'WARNING: the plugin was built against PipeWire %s, installed is %s.\n' \
            "$built" "$now" >&2
        printf '         If there is no sound: rebuild in the project directory and\n' >&2
        printf '         run ./install-hal.sh again.\n' >&2
    fi
    return 0
}

# The hand-built AAC codec module has the same problem, for Bluetooth.
#
# Debian ships no AAC module, so most earbuds fall back to SBC - see
# tools/build-bluez5-aac.sh. That module is built against PipeWire's internal
# codec interface; after an update it may simply stop loading, and the only
# symptom would be that Bluetooth music quietly sounds worse than yesterday.
aac_version_check() {
    local dir built now
    dir=$(pkg-config --variable=libdir libpipewire-0.3 2>/dev/null)/spa-0.2/bluez5
    [ -r "$dir/aac-built-against" ] || return 0
    built=$(cat "$dir/aac-built-against")
    now=$(pkg-config --modversion libpipewire-0.3 2>/dev/null)
    [ -n "$now" ] || return 0
    if [ "$built" != "$now" ]; then
        printf 'NOTE: the Bluetooth AAC module was built against PipeWire %s, installed is %s.\n' \
            "$built" "$now" >&2
        printf '      Bluetooth music falls back to SBC until it is rebuilt:\n' >&2
        printf '      ./tools/build-bluez5-aac.sh\n' >&2
    fi
    return 0
}

# WirePlumber's droid monitor may only run when PipeWire is meant to hold the
# HAL. In the pw-tunnel profile PulseAudio holds it - if the monitor started
# there it would reach for the same device.
# The system file that loads the monitor (50-droid.conf in /usr/share) is never
# touched. Turning the monitor off is a file of our own in the user's
# configuration, read after it and switching the components to "disabled";
# turning it on again is removing that file. WirePlumber reads conf.d in
# alphabetical order, so 99- wins over 50-.
droid_monitor_off_file() {
    mkdir -p "$WPUSER" || return 1
    cat > "$WPOFF" <<'WPEOF'
# Written by audioctl for the pw-tunnel profile, removed again for the others.
#
# There PulseAudio owns the Android HAL, and the droid monitor would reach for
# the same device. This turns the components off without touching the system
# file that declares them.
wireplumber.profiles = {
  main = {
    monitor.droid = disabled
    policy.droid-input-follows-output = disabled
    policy.droid-default-sink-policy = disabled
    policy.droid-bluetooth-call = disabled
  }
}
WPEOF
}

droid_monitor() {
    case "$1" in
    on)  [ -e "$WPOFF" ] && run rm -f "$WPOFF" ;;
    off) [ -e "$WPOFF" ] || run droid_monitor_off_file ;;
    esac
    return 0
}

# --- preconditions per profile ---------------------------------------------
preflight() {
    case "$1" in
    standard) : ;;
    pw-tunnel)
        [ -e /usr/lib/aarch64-linux-gnu/pipewire-0.3/libpipewire-module-pulse-tunnel.so ] \
            || die "libpipewire-module-pulse-tunnel.so is missing."
        [ -e "$LOCAL/tunnel.conf" ] || die "$LOCAL/tunnel.conf is missing."
        ;;
    pw-hal)
        plugin_version_check
        aac_version_check
        [ -e /usr/lib/aarch64-linux-gnu/spa-0.2/droid/libspa-droid.so ] \
            || die "SPA droid plugin not built yet - the pw-hal profile stays locked until then."
        command -v wireplumber >/dev/null \
            || die "wireplumber is not installed (apt install wireplumber)."
        ;;
    *) die "unknown profile '$1'. Known: $PROFILES" ;;
    esac
}

# --- apply profiles ---------------------------------------------------------
apply() {
    local p=$1
    known_profile "$p" || { warn "refusing to apply \"$p\" - not a profile"; return 1; }
    case "$p" in
    standard)
        droid_monitor on
        run uctl stop furios-pw-tunnel.service 2>/dev/null
        run uctl disable furios-pw-tunnel.service 2>/dev/null
        # Masking does not stop a RUNNING service - stop it first, otherwise
        # pipewire-pulse keeps holding the Pulse socket.
        run uctl stop pipewire-pulse.service pipewire-pulse.socket 2>/dev/null
        run uctl stop wireplumber.service 2>/dev/null
        # Give the want back too, not just the running service - see the
        # pw-hal branch below for why it is there at all.
        run uctl disable wireplumber.service 2>/dev/null
        mask   pipewire-pulse.service pipewire-pulse.socket wireplumber.service
        unmask pulseaudio.service pulseaudio.socket
        run dropin_remove
        run uctl daemon-reload
        # A failed pw-hal leaves pipewire in 'failed' - without reset-failed
        # the camera would stay dead. Reset first, then start.
        run uctl reset-failed pipewire.service 2>/dev/null
        run uctl restart pipewire.service
        # restart rather than start: pipewire-pulse takes the socket down with
        # it, so a plain start would not recreate it.
        run uctl restart pulseaudio.socket pulseaudio.service
        ;;
    pw-tunnel)
        # PulseAudio keeps the HAL and the Pulse socket. PipeWire additionally
        # gets a tunnel sink. Telephony is untouched.
        #
        # WirePlumber MUST run here: without a session manager nobody links the
        # streams and the tunnel sink would stay unused - which is exactly how
        # this profile failed on its first test. Its droid monitor stays off,
        # otherwise it would reach for the HAL that PulseAudio holds.
        droid_monitor off
        mask   pipewire-pulse.service pipewire-pulse.socket
        unmask pulseaudio.service pulseaudio.socket wireplumber.service
        run dropin_remove
        run uctl daemon-reload
        run uctl start pulseaudio.socket pulseaudio.service
        run uctl enable wireplumber.service
        run uctl restart wireplumber.service
        run uctl enable --now furios-pw-tunnel.service
        ;;
    pw-hal)
        # PipeWire takes over the HAL. PulseAudio has to give way (the HAL is
        # exclusive).
        droid_monitor on
        run uctl stop furios-pw-tunnel.service 2>/dev/null
        run uctl disable furios-pw-tunnel.service 2>/dev/null
        run uctl stop pulseaudio.service pulseaudio.socket
        mask   pulseaudio.service pulseaudio.socket
        unmask pipewire-pulse.service pipewire-pulse.socket wireplumber.service
        # The drop-in is generated rather than a fixed file linked into place:
        # the path to the configuration depends on whether the install came
        # from the source tree (/usr/local) or from the package (/usr). The
        # helper works that out itself - it takes no path from here.
        if [ "$DRY" = 1 ]; then
            printf '  [dry run] write %s (-c %s/pipewire-hal.conf)\n' \
                "$DROPIN" "$LOCAL"
        else
            dropin_write
        fi
        run uctl daemon-reload
        # Nothing on this system wants WirePlumber. Its [Install] says
        # WantedBy=pipewire.service, but the want is only written when someone
        # enables it, and audioctl never did - it started the service by hand
        # and that was enough for as long as nobody looked past the session.
        #
        # Across a reboot it is not enough: pipewire comes back, no session
        # manager comes with it, no card is ever created and the phone is
        # silent on a profile that works perfectly when switched to by hand.
        # "enable" writes the want into ~/.config/systemd/user, where the
        # first transaction of the next boot can already see it.
        run uctl enable wireplumber.service
        run uctl restart pipewire.service
        run uctl start wireplumber.service pipewire-pulse.socket pipewire-pulse.service
        ;;
    esac
}

# --- verification: is there a usable sink? ----------------------------------
verify() {
    # Fifteen seconds is what a real switch needs; the tests set it to one, so
    # a suite that exercises this path does not spend minutes asleep.
    # The boot check passes its own number here: a boot is slower than a
    # switch on a warm system. Through the environment the larger value would
    # have stayed in force for every later call in the same run.
    local i=0 tries=${1:-${VERIFY_TRIES:-15}}
    while [ $i -lt "$tries" ]; do
        # auto_null is PipeWire's fallback sink: it exists precisely when no
        # real device came up. Accepting it would let the safety net pass on a
        # plugin that failed to load - the switch would look successful and
        # leave the phone silent, which is the one case this check exists for.
        # NF skips blank lines: a stray empty line would otherwise count as
        # a sink, and this is the check the auto-revert hangs on.
        if pactl list sinks short 2>/dev/null | awk 'NF {print $2}' \
                | grep -qvx auto_null; then
            return 0
        fi
        i=$((i+1)); sleep 1
    done
    return 1
}

# --- after the stack: did the stored profile actually produce sound? --------
#
# "audioctl boot" writes the configuration before the stack starts and so
# cannot judge it - there is nothing up yet to ask. This runs afterwards, from
# furios-audio-verify.service, and is the only place where a profile that comes
# up silent is caught. Without it a stored pw-hal that breaks - a plugin no
# longer matching a new PipeWire, say - leaves the phone mute with no way back
# except a command line.
#
# It allows the stack twice as long as an interactive switch. A boot is slower
# than a switch on a warm system, and a fallback that fires because the HAL was
# merely slow would be worse than what it guards against.
boot_check() {
    local p sinks
    p=$(current_profile)
    if verify "${BOOT_VERIFY_TRIES:-30}"; then
        sinks=$(pactl list sinks short 2>/dev/null | awk '{print $2}' | paste -sd, -)
        printf 'boot check: profile %s has a sink (%s)\n' "$p" "$sinks"
        return 0
    fi
    printf 'boot check: profile %s produced no sink. Falling back to standard.\n' "$p" >&2
    # The stored profile is deliberately NOT rewritten, exactly as in the
    # interactive fallback. A silent boot is a reason to make sound work now,
    # not to quietly drop a choice somebody made: "audioctl status" shows the
    # mismatch, and the next boot tries the profile again instead of pretending
    # nothing happened. A test profile does go, because that is what try means.
    apply standard
    rm -f "$TRY"
    if verify; then
        printf 'boot check: standard restored.\n'
        return 0
    fi
    # Left failed on purpose: this is the one state nobody can hear their way
    # out of, and "systemctl --user --failed" is where it belongs.
    printf 'boot check: standard delivers no sink either.\n' >&2
    return 1
}

# callaudiod and feedbackd hold persistent connections to the audio server.
# A profile switch changes the server - afterwards callaudiod finds no card any
# more ("No suitable card found") and feedbackd fails with "Invalid state": no
# ringtone, only vibration. Killing them is enough, D-Bus starts both again on
# the next call.
restart_audio_clients() {
    local restarted=""
    pkill -x callaudiod 2>/dev/null && restarted="callaudiod"
    pkill -x feedbackd  2>/dev/null && restarted="${restarted:+$restarted, }feedbackd"
    [ -n "$restarted" ] && info "restarted: $restarted (D-Bus activates them on demand)"
    warm_callaudiod
    return 0
}

# Start callaudiod now, rather than letting the first call pay for it.
#
# Measured on 2026-09-11: when SelectMode is the method that activates
# callaudiod over D-Bus, it arrives while callaudiod is still bringing its
# PulseAudio connection up ("PA not ready") and blocks until the D-Bus
# timeout - 25 seconds, twice out of two tries against our stack, never
# against the shipped one. gnome-calls then logs "Failed to select audio mode:
# Timeout was reached", the card never reaches the voicecall profile, and the
# call has no audio in either direction. That is what a first call after every
# profile switch looked like, because switching kills callaudiod.
#
# Reading a property activates the service without asking it to do anything,
# and after that SelectMode answers in about a second. A failure here is not
# worth reporting: the worst case is the state we were in anyway.
warm_callaudiod() {
    command -v busctl >/dev/null 2>&1 || return 0
    [ "$DRY" = 1 ] && { printf '  [dry] warm up callaudiod\n'; return 0; }
    busctl --user get-property org.mobian_project.CallAudio \
        /org/mobian_project/CallAudio org.mobian_project.CallAudio AudioMode \
        >/dev/null 2>&1 || true
    sleep "${CALLAUDIO_WARMUP:-2}"
    return 0
}

# The safety net has to be enabled: it discards a test profile on reboot.
# A package cannot enable it - a user unit is only enabled by the user
# themselves. So it happens here, on the first switch.
# Pausing instead of blaring: when a Bluetooth headset disconnects the audio
# would otherwise move to the loudspeaker, wherever you happen to be standing.
# Like the safety net, a user unit can only be enabled by the user.
ensure_pause_on_disconnect() {
    uctl is-enabled furios-audio-pause-on-disconnect.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-pause-on-disconnect.service >/dev/null 2>&1; then
        run uctl enable --now furios-audio-pause-on-disconnect.service >/dev/null 2>&1 \
            && info "playback now pauses when Bluetooth disconnects"
    fi
    return 0
}

# callaudiod keeps the card index it looked up once. Every WirePlumber restart
# gives the card a new one, and the next call then blocks for 25 seconds
# instead of switching the profile - no audio in either direction. A profile
# switch takes care of it here; this unit covers every other way WirePlumber
# comes back. Like the others, only the user can enable their own unit.
ensure_callaudio_refresh() {
    uctl is-enabled furios-audio-callaudio-refresh.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-callaudio-refresh.service >/dev/null 2>&1; then
        run uctl enable furios-audio-callaudio-refresh.service >/dev/null 2>&1 \
            && info "callaudiod is refreshed when WirePlumber restarts"
    fi
    return 0
}

# A call routed to a headset is still silent without a link to carry it: the
# profile says the card CAN carry SCO, and only a stream on bluez_output makes
# one exist. Nothing opens one during a call - the voice path runs modem <->
# DSP and never reaches the host - so this service does. Measured 2026-09-12:
# same call, same routing, silent without it and heard with it.
#
# Harmless while the routing is off, because it holds nothing unless the card
# is already in a hands-free profile. Like the others, only the user can
# enable their own unit.
ensure_sco_hold() {
    uctl is-enabled furios-audio-sco-hold.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-sco-hold.service >/dev/null 2>&1; then
        run uctl enable --now furios-audio-sco-hold.service >/dev/null 2>&1 \
            && info "the Bluetooth link is now held open during a call"
    fi
    return 0
}

# The other half of the safety net: furios-audio-apply.service writes the
# configuration before the stack, this one checks after it. Enabled the same
# way - only the user can enable their own unit.
ensure_boot_check() {
    uctl is-enabled furios-audio-verify.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-verify.service >/dev/null 2>&1; then
        run uctl enable furios-audio-verify.service >/dev/null 2>&1 \
            && info "a boot that comes up silent now falls back to standard"
    fi
    return 0
}

ensure_safety_net() {
    uctl is-enabled furios-audio-apply.service >/dev/null 2>&1 && return 0
    if uctl cat furios-audio-apply.service >/dev/null 2>&1; then
        run uctl enable furios-audio-apply.service >/dev/null 2>&1 \
            && info "safety net enabled (discards test profiles on reboot)"
    fi
    return 0
}

switch_to() {
    local p=$1 mode=$2 prev
    warn_about_legacy
    prev=$(current_profile)
    ensure_safety_net
    ensure_boot_check
    ensure_pause_on_disconnect
    ensure_callaudio_refresh
    ensure_sco_hold
    preflight "$p"
    printf 'switching: %s -> %s (%s)\n' "$prev" "$p" "$mode"
    apply "$p"
    [ "$DRY" = 1 ] && { echo "dry run finished, nothing changed."; return 0; }

    # At boot there is nothing yet to restart and nothing yet to verify: the
    # stack starts after this, from the configuration just written. Asking
    # pactl for a sink here would time out fifteen seconds and then "fall back
    # to standard" over a stack that had simply not been started.
    if [ "$mode" = boot ]; then
        info "configuration written - systemd starts the stack from it"
        return 0
    fi

    restart_audio_clients

    if verify; then
        info "OK - sink present: $(pactl list sinks short | awk '{print $2}' | paste -sd, -)"
        info "Pulse server: $(pulse_owner)"
        case "$mode" in
        sticky) write_state "$STICKY" "$p"; rm -f "$TRY"
                info "set persistently (survives a reboot)" ;;
        try)    write_state "$TRY" "$p"
                info "only until the next reboot - then back to '$(cat "$STICKY" 2>/dev/null || echo standard)'" ;;
        esac
        [ "$p" != standard ] && info "please check telephony: call, ringtone, earpiece/speaker."
        return 0
    fi

    printf 'FAILED - no sink after 15s. Falling back to standard.\n' >&2
    apply standard
    rm -f "$TRY"
    verify && info "standard restored." || info "WARNING: standard does not deliver a sink either."
    return 1
}

# --- put a call on a Bluetooth headset -------------------------------------
#
# callaudiod only knows earpiece and speaker. For a headset two things have to
# come together: the headset in its hands-free profile (so an SCO channel is
# up) and the phone card on the route output-bluetooth_sco (so the HAL sends
# BT_SCO=on and puts the voice path there).
#
# The BT ports are missing from this device's audio_policy XML - they are
# commented out. Our plugin builds them itself; the HAL does not need the
# file, when routing it only gets the device type.
#
# Active ports of the respective stack. The nodes are named differently: under
# pw-hal droid-sink/droid-source, in the shipped state sink.primary_output and
# PulseAudio's droid source.
port_of() {
    local kind=$1 name
    for name in $2; do
        pactl list "$kind" 2>/dev/null | sed -n "/Name: $name\$/,/^\$/p" \
            | sed -n 's/.*Active Port: //p' | head -1 | grep . && return 0
    done
    printf '?'
}

active_ports() {
    printf '%s / %s' \
        "$(port_of sinks 'droid-sink sink.primary_output')" \
        "$(port_of sources 'droid-source source.primary_input')"
}

droid_profile() {
    pactl list cards 2>/dev/null | sed -n '/Name: droid$/,/^$/p' | sed -n 's/.*Active Profile: //p'
}

# Also writes to the journal - during a call test nobody is sitting at the
# terminal, and afterwards you want to know what really happened:
#   journalctl --user -t audioctl --since -10min
btlog() {
    printf '%s\n' "$*"
    command -v logger >/dev/null 2>&1 && logger -t audioctl -- "$*"
    return 0
}

# Which of the two Bluetooth paths is speaking. The shared helpers below are
# used by both "bt-call" and "bt-mic", and a log line that names the wrong one
# sends the next reader to the wrong place.
BTTAG=bt-call

# Force the headset into its hands-free profile so an SCO channel is up.
bt_headset_profile() {
    local card=$1 want=$2 prof
    [ -n "$card" ] || return 1
    if [ "$want" = headset ]; then
        pactl set-card-profile "$card" headset-head-unit 2>/dev/null && { btlog "$BTTAG: headset profile headset-head-unit"; return 0; }
        pactl set-card-profile "$card" headset-head-unit-cvsd 2>/dev/null && { btlog "$BTTAG: headset profile headset-head-unit-cvsd (narrowband)"; return 0; }
        prof=$(pactl list cards 2>/dev/null | sed -n "/$card/,/^$/p" | sed -n 's/.*Active Profile: //p')
        btlog "$BTTAG: WARNING hands-free profile could not be set (active: ${prof:-unknown})"
        return 1
    fi
    pactl set-card-profile "$card" a2dp-sink 2>/dev/null
    return 0
}

# Set the phone card's routes and report what actually took effect.
bt_set_ports() {
    local sink_port=$1 src_port=$2
    pactl set-sink-port   droid-sink   "$sink_port" 2>/dev/null \
        && btlog "$BTTAG: output $sink_port set" \
        || btlog "$BTTAG: ERROR - could not set output $sink_port"
    pactl set-source-port droid-source "$src_port" 2>/dev/null \
        && btlog "$BTTAG: input $src_port set" \
        || btlog "$BTTAG: ERROR - could not set input $src_port"
    btlog "$BTTAG: actually active $(active_ports)"
}

# Defend the route against callaudiod for as long as the call runs.
bt_hold() {
    # Two seconds between checks; the tests set it to zero, because a suite
    # that sleeps through half an hour of holding is a suite nobody runs.
    local sink_port=$1 src_port=$2 limit=$3 i=0 now
    local interval=${BT_HOLD_INTERVAL:-2}
    while [ $i -lt "$limit" ]; do
        [ "$interval" = 0 ] || sleep "$interval"
        now=$(pactl list sinks 2>/dev/null | sed -n '/Name: droid-sink/,/^$/p' | sed -n 's/.*Active Port: //p')
        if [ "$now" != "$sink_port" ]; then
            btlog "$BTTAG: output was on \"$now\" - setting it again"
            pactl set-sink-port   droid-sink   "$sink_port" 2>/dev/null
            pactl set-source-port droid-source "$src_port"  2>/dev/null
        fi
        # Call over? Then stop.
        [ "$(droid_profile)" = voicecall ] || return 0
        i=$((i+1))
    done
    return 0
}

# Make sound audible again - the emergency handle.
#
# Born out of a failed Bluetooth test: afterwards the output was on the
# earpiece and the volume at 18 %. Technically everything was running, nothing
# was audible. That exact combination is what rescue clears away.
rescue() {
    local to_standard=${1:-yes}
    [ "$to_standard" = yes ] && switch_to standard sticky
    pactl set-sink-mute   @DEFAULT_SINK@   0    2>/dev/null || true
    pactl set-source-mute @DEFAULT_SOURCE@ 0    2>/dev/null || true
    pactl set-sink-volume @DEFAULT_SINK@   65%  2>/dev/null || true
    # Speaker, not earpiece: on the earpiece you hear nothing unless you hold
    # the device to your ear.
    pactl set-sink-port sink.primary_output output-speaker 2>/dev/null || \
    pactl set-sink-port droid-sink          output-speaker 2>/dev/null || true
    pactl set-source-port droid-source input-builtin_mic   2>/dev/null || true
    info "sound restored: speaker, 65 %, not muted"
    info "active: $(active_ports)"
    return 0
}

bt_call() {
    local mode=$1 card waited BTTAG=bt-call
    card=$(pactl list short cards 2>/dev/null | awk '/bluez_card/ {print $2; exit}')

    # An aborted test must not leave the phone silent: Ctrl-C or an error
    # restore an audible state.
    trap 'printf "\naborted - restoring the sound.\n" >&2; rescue no; trap - INT TERM EXIT; exit 130' INT TERM

    case "$mode" in
    on)
        [ -n "$card" ] || { btlog "bt-call: no Bluetooth device connected"; return 1; }
        btlog "bt-call: card $card"
        bt_headset_profile "$card" headset
        bt_set_ports output-bluetooth_sco input-bluetooth_sco_headset
        bt_hold output-bluetooth_sco input-bluetooth_sco_headset 10
        btlog "bt-call: done, active $(active_ports)"
        printf 'Back with: audioctl bt-call off\n'
        ;;
    off)
        bt_headset_profile "$card" a2dp
        bt_set_ports output-earpiece input-builtin_mic
        ;;
    watch)
        # Start this before the call: it waits, then puts the call on the
        # headset itself and holds the route until you hang up. That way nobody
        # has to type anything while on the phone - which is exactly what made
        # the earlier attempts fail.
        [ -n "$card" ] || { btlog "bt-call watch: no Bluetooth device connected"; return 1; }
        btlog "bt-call watch: waiting for a call (abort with Ctrl-C)"
        waited=0
        while [ "$(droid_profile)" != voicecall ]; do
            sleep 1
            waited=$((waited+1))
            [ $waited -ge 600 ] && { btlog "bt-call watch: no call after 10 minutes - stopping"; return 1; }
        done
        btlog "bt-call watch: call detected after ${waited}s"
        bt_headset_profile "$card" headset
        bt_set_ports output-bluetooth_sco input-bluetooth_sco_headset
        # Hold until hang-up, at most 30 minutes.
        bt_hold output-bluetooth_sco input-bluetooth_sco_headset 900
        btlog "bt-call watch: call ended - back to the phone"
        bt_headset_profile "$card" a2dp
        bt_set_ports output-earpiece input-builtin_mic
        ;;
    *) trap - INT TERM; die "bt-call needs 'on', 'off' or 'watch'." ;;
    esac
    trap - INT TERM
    return 0
}

# --- the headset's microphone, without a call ------------------------------
#
# Music comes back from the earbuds over A2DP, and in that profile the headset
# offers no microphone at all. That is deliberate - see 51-bluez-ofono.conf:
# the node BlueZ would offer is the HOST side of SCO, and SCO does not cross
# HCI on this chip. It looks like a working microphone in every recorder and
# it records digital silence.
#
# The microphone that does work is the one the HAL reaches, and getting there
# takes the same three steps a call takes:
#
#   1. the headset into a hands-free profile, so an SCO channel exists at all
#   2. the codec told to the HAL, which otherwise encodes narrow-band CVSD
#      while the profile above negotiates wide-band mSBC - and mismatched,
#      nothing intelligible arrives
#   3. the phone card's input on input-bluetooth_sco_headset, which is what
#      makes the HAL send BT_SCO=on
#
# droid-bluetooth-call.lua does all of this already, but only when the card
# enters the voicecall profile. A voice memo is not a call, so nothing
# happened - which is exactly what this is for.
#
# It also needs a stream on bluez_output.* for as long as it records, and
# that is not obvious: 51-bluez-ofono.conf says the SCO link exists while such
# a stream is active, and a hold was built for it, and then a test seemed to
# show it was pointless - recording with the hold stopped still came back at
# 940 distinct values. It was measured inside the link the hold had just put
# up: profile, codec and route were already in place and the link was still
# standing. Coming at it cold instead - a2dp-sink, then the whole sequence
# with no hold - the same recording is 46394 samples, 1 distinct value, RMS 0.
#
# So the profile alone does not carry it, and the reading that told us
# otherwise was taken in the warmth of the thing it was meant to rule out.
#
# The price is that A2DP is gone while it lasts: the hands-free profile has no
# high-fidelity sink, so whatever plays goes out narrow-band and mono. That is
# why this is a command rather than an automatism, and why every path back
# through here puts the headset on a2dp-sink again.

# Where the hold's pid lives. The runtime directory and nowhere else: a
# predictable name in /tmp is how the last two sloppy files in this tree were
# found, and this one gets a kill sent to whatever pid it names.
sco_hold_pid_file() {
    [ -n "${XDG_RUNTIME_DIR:-}" ] || return 1
    printf '%s/furios-audio-sco-hold.pid' "$XDG_RUNTIME_DIR"
}

# The id of a PipeWire node by name.
#
# Needed because the codec below cannot go through the card: the card lives in
# WirePlumber's process and the nodes in PipeWire's, and nothing carries a card
# parameter across that on its own - measured, the node receives droid.route,
# which droid.lua sends to the node, and nothing else the card publishes.
bt_node_id() {
    pw-cli ls Node 2>/dev/null | awk -v want="$1" '
        /^[[:space:]]*id [0-9]+,/ { id = $2; sub(",", "", id); next }
        index($0, "node.name = \"" want "\"") { print id; exit }'
}

# Tell both phone nodes which codec the Bluetooth link runs.
#
# The HAL reads bt_wbs when it opens a stream, and it is the route that makes
# it open - so this has to happen BEFORE the route is set. Both nodes are told
# because bt_wbs belongs to the HAL module rather than to one stream, and
# either of them may be the next to open one. droid-bluetooth-call.lua says
# the same thing to the same two nodes; this is the path for everything that
# is not a call.
bt_tell_codec() {
    local profile=$1 wbs name id told=0
    case "$profile" in
    headset-head-unit)      wbs=on ;;
    headset-head-unit-cvsd) wbs=off ;;
    # Anything else and we do not know. Guessing here is a coin toss between
    # working audio and silence, so say nothing and let the HAL keep its
    # default - the node writes a line when it opens Bluetooth without a
    # codec, which is better than a wrong guess nobody can see.
    *) btlog "$BTTAG: unknown profile \"${profile:-none}\" - the HAL keeps its default codec"; return 1 ;;
    esac
    for name in droid-sink droid-source; do
        id=$(bt_node_id "$name")
        [ -n "$id" ] || continue
        pw-cli set-param "$id" Props "{ params = [ \"droid.bt-wbs\", \"$wbs\" ] }" >/dev/null 2>&1 \
            && told=$((told+1))
    done
    [ "$told" -gt 0 ] || { btlog "$BTTAG: WARNING no node took the codec - the HAL stays on narrow-band"; return 1; }
    btlog "$BTTAG: codec bt_wbs=$wbs (told $told nodes)"
    return 0
}

# What profile the Bluetooth card is actually in right now.
bt_active_profile() {
    local card=$1
    [ -n "$card" ] || return 1
    pactl list cards 2>/dev/null | sed -n "/Name: $card\$/,/^\$/p" \
        | sed -n 's/.*Active Profile: //p' | head -1
}

# Hold the SCO link up for as long as the microphone is wanted.
#
# A silent stream, and nothing of it is heard: what gets recorded comes off
# the Bluetooth link through the HAL, not through this. It is here because
# without it the HAL opens its Bluetooth capture onto a link that is not
# there and records digital silence - measured, see above.
#
# It ends by itself. A hold that outlives the recording leaves the earbuds in
# a hands-free profile, where music is narrow-band and mono, and that is the
# kind of state somebody finds hours later and blames on the headset.
bt_sco_hold_start() {
    local seconds=$1 sink pidfile pid
    pidfile=$(sco_hold_pid_file) || { btlog "$BTTAG: no XDG_RUNTIME_DIR - not holding SCO open"; return 1; }
    sink=$(pactl list short sinks 2>/dev/null | awk '/bluez_output/ {print $2; exit}')
    [ -n "$sink" ] || { btlog "$BTTAG: no Bluetooth sink - nothing to hold the link open with"; return 1; }
    bt_sco_hold_stop
    # setsid, because the hold has to outlive the audioctl that started it.
    # Without it the stream is a child of this shell and in its process group,
    # and it goes down with the command - which produced exactly one silent
    # recording here on 2026-09-12: "audioctl bt-mic on" reported the hold,
    # the recording a few minutes later came back at 1 distinct value, and the
    # status line said "not running" with the link already gone.
    #
    # timeout passes on the signal it is sent, so stopping it stops paplay.
    setsid timeout "$seconds" paplay --raw --format=s16le --rate=16000 --channels=1 \
        --device="$sink" /dev/zero >/dev/null 2>&1 </dev/null &
    pid=$!
    ( umask 077; printf '%s\n' "$pid" > "$pidfile" )
    btlog "$BTTAG: holding the link on $sink, at most ${seconds}s (pid $pid)"
    return 0
}

bt_sco_hold_stop() {
    local pidfile pid
    pidfile=$(sco_hold_pid_file) || return 0
    [ -r "$pidfile" ] || return 0
    pid=$(cat "$pidfile" 2>/dev/null)
    rm -f "$pidfile"
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    kill "$pid" 2>/dev/null && btlog "$BTTAG: link hold stopped"
    return 0
}

# Whether the HAL really has the Bluetooth line open.
#
# This is the one reading that cannot be talked around. The route can say
# input-bluetooth_sco_headset and the HAL can answer BT_SCO=on while the
# samples still come from the built-in microphone - measured here on
# 2026-09-12, and it reads as success all the way down to the recording. The
# BTCVSD capture device does not lie: RUNNING means the bytes are coming off
# the Bluetooth link, closed means they are coming from somewhere else.
bt_pcm_state() {
    local st
    st=$(head -1 /proc/asound/card0/pcm55c/sub0/status 2>/dev/null)
    printf '%s' "${st:-unknown}"
}

# Measure what actually arrives.
#
# "The microphone is selected" and "the microphone records something" have
# been two different things on this device more than once - a route can land
# on the wrong device and the recording still runs, perfectly, over silence.
# So the answer here is a number, and the number that matters is how many
# distinct sample values came back: one means digital silence, whatever the
# level meters say.
bt_mic_measure() {
    local seconds=${1:-3} src=${2:-droid-source} raw
    raw=$(mktemp "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/audioctl-mic.XXXXXX") || return 1
    # pw-record and not parecord: on this stack parecord comes back with an
    # empty file and no error at all - measured, 0 bytes raw and a bare 44-byte
    # header as WAV, while pw-record on the same source in the same second
    # returned 62112 bytes. A measuring instrument that silently reads zero is
    # worse than none, because zero is exactly the answer this is looking for.
    #
    # The recording is ended by the clock, so its WAV header carries a length
    # that was never filled in. The samples are read past the header instead of
    # through it - the bytes are all there, it is only the header that is not.
    timeout "$seconds" pw-record --target "$src" --rate 16000 --channels 1 \
        --format s16 "$raw" >/dev/null 2>&1
    python3 - "$raw" <<'PY_END'
import array, os, sys
path = sys.argv[1]
try:
    with open(path, "rb") as f:
        blob = f.read()
finally:
    try: os.unlink(path)
    except OSError: pass
at = blob.find(b"data")
body = blob[at + 8:] if at >= 0 else blob[44:]
a = array.array("h")
a.frombytes(body[:len(body) // 2 * 2])
if not a:
    print("nothing was recorded at all")
    raise SystemExit(1)
peak = max(max(a), -min(a))
rms = (sum(x * x for x in a) / len(a)) ** 0.5
distinct = len(set(a))
print("%d samples, %d distinct value%s, RMS %.1f, peak %d"
      % (len(a), distinct, "" if distinct == 1 else "s", rms, peak))
if distinct <= 1:
    print("digital silence - nothing is arriving from this source")
    raise SystemExit(2)
PY_END
}

bt_mic() {
    local mode=$1 arg=${2:-} card prof BTTAG=bt-mic

    card=$(pactl list short cards 2>/dev/null | awk '/bluez_card/ {print $2; exit}')

    # An aborted run must not leave the earbuds hands-free and the phone
    # recording from nowhere. Ctrl-C puts everything back.
    trap 'printf "\naborted - putting the headset back.\n" >&2; bt_sco_hold_stop; bt_headset_profile "$card" a2dp; pactl set-source-port droid-source input-builtin_mic 2>/dev/null; trap - INT TERM EXIT; exit 130' INT TERM

    case "$mode" in
    on)
        [ -n "$card" ] || { btlog "bt-mic: no Bluetooth device connected"; trap - INT TERM; return 1; }
        btlog "bt-mic: card $card"
        bt_headset_profile "$card" headset || { trap - INT TERM; return 1; }
        prof=$(bt_active_profile "$card")
        # Before the route: the route is what makes the HAL open a stream, and
        # the codec has to be in place by then.
        bt_tell_codec "$prof"
        bt_sco_hold_start "${arg:-600}"
        pactl set-source-port droid-source input-bluetooth_sco_headset 2>/dev/null \
            && btlog "bt-mic: input input-bluetooth_sco_headset set" \
            || btlog "bt-mic: ERROR - could not set input input-bluetooth_sco_headset"
        btlog "bt-mic: active $(active_ports)"
        printf 'Recording now uses the headset. Check with: audioctl bt-mic test\n'
        printf 'Back with: audioctl bt-mic off\n'
        ;;
    off)
        bt_sco_hold_stop
        pactl set-source-port droid-source input-builtin_mic 2>/dev/null \
            && btlog "bt-mic: input input-builtin_mic set" \
            || btlog "bt-mic: ERROR - could not set input input-builtin_mic"
        bt_headset_profile "$card" a2dp
        btlog "bt-mic: active $(active_ports)"
        ;;
    test)
        # Three seconds by default: long enough to say something into the
        # headset, short enough that nobody stops reading.
        # A recording taken with no hold is silence no matter what the
        # microphone does, and it looks exactly like a broken headset.
        local pidfile pid
        pidfile=$(sco_hold_pid_file 2>/dev/null) && pid=$(cat "$pidfile" 2>/dev/null)
        if ! { [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; }; then
            printf 'WARNING: nothing is holding the link open - expect silence.\n' >&2
            printf '         Switch it on again with: audioctl bt-mic on\n' >&2
        fi
        printf 'Recording %s s - say something.\n' "${arg:-3}"
        bt_mic_measure "${arg:-3}" || { trap - INT TERM; return $?; }
        ;;
    status)
        printf 'Bluetooth card:     %s\n' "${card:-none connected}"
        printf 'Headset profile:    %s\n' "$(bt_active_profile "$card" 2>/dev/null || echo -)"
        printf 'Phone ports:        %s\n' "$(active_ports)"
        local pidfile pid
        pidfile=$(sco_hold_pid_file 2>/dev/null) && pid=$(cat "$pidfile" 2>/dev/null)
        if [ -n "${pid:-}" ] && kill -0 "$pid" 2>/dev/null; then
            printf 'Link hold:          running (pid %s)\n' "$pid"
        else
            printf 'Link hold:          not running\n'
        fi
        printf 'HAL Bluetooth PCM:  %s\n' "$(bt_pcm_state)"
        ;;
    *) trap - INT TERM; die "bt-mic needs 'on', 'off', 'test' or 'status'." ;;
    esac
    trap - INT TERM
    return 0
}

usage() {
    cat <<EOF
audioctl - switch the audio stack

  audioctl status              show the current state
  audioctl toggle              switch: standard <-> pw-hal (in test mode)
  audioctl list                list the profiles
  audioctl try <profile>       switch, falls back on reboot
  audioctl set <profile>       switch and remember persistently
  audioctl restart             restart the audio stack, keep the profile
  audioctl rescue              make sound audible again: shipped state,
                               speaker, 65 %, not muted
  audioctl bt-call watch       start before the call: puts the call on the
                               Bluetooth headset itself and holds it there
  audioctl bt-call on|off      move a running call by hand
  audioctl bt-mic on|off       record from the Bluetooth headset outside a
                               call (a voice memo); music turns narrow-band
                               while it is on, so put it back afterwards
  audioctl bt-mic test [s]     record a few seconds and say what arrived
  audioctl bt-mic on [s]       hold the link for s seconds (default 600)
  audioctl bt-mic status       headset profile, phone ports, link hold, and
                               whether the HAL has the Bluetooth line open
  audioctl revert              back to standard immediately
  audioctl boot                write the stored profile's configuration
                               without starting anything (used at boot)
  audioctl boot-check          after the stack: fall back to standard if the
                               profile came up without a sink (used at boot)
  sudo audioctl migrate        once, if an older version left system-wide
                               state behind (it says so when it matters)
  audioctl verify              check whether a sink is there

  --dry-run                    only show what would happen

Profiles:
  standard    FuriOS as shipped: PulseAudio holds the HAL, PipeWire does video
  pw-tunnel   like standard, plus a PipeWire tunnel sink (telephony untouched)
  pw-hal      PipeWire holds the HAL via the SPA droid plugin (playback, capture
              and telephony confirmed on the device)
EOF
}

status() {
    local eff rec
    eff=$(effective_profile)
    rec=$(current_profile)
    printf 'Profile (active):   %s\n' "$eff"
    if [ "$eff" != "$rec" ]; then
        printf 'WARNING:            recorded is "%s" - that does not match the running system.\n' "$rec"
        printf '                    Bring it back in line with "audioctl set %s".\n' "$eff"
    fi
    printf 'Profile (persistent):%s\n' " $(cat "$STICKY" 2>/dev/null || echo standard)"
    [ -r "$TRY" ] && printf 'Test mode:          yes - falls back on reboot\n'
    printf 'Pulse server:       %s\n' "$(pulse_owner)"
    printf 'Sinks:              %s\n' "$(pactl list sinks short 2>/dev/null | awk '{print $2}' | paste -sd, - || echo none)"
    printf '\nUnits:\n'
    for u in pulseaudio.service pipewire.service pipewire-pulse.service wireplumber.service furios-pw-tunnel.service; do
        printf '  %-28s %-10s %s\n' "$u" "$(uctl is-enabled "$u" 2>&1 | head -1)" "$(uctl is-active "$u" 2>&1 | head -1)"
    done
}

# Sourcing this file with AUDIOCTL_LIB=1 gives access to the functions without
# running anything - that is how tests/test-audioctl.sh gets at verify() and
# effective_profile() with stubbed pactl and systemctl.
if [ -n "${AUDIOCTL_LIB:-}" ]; then
    return 0 2>/dev/null || exit 0
fi

# Root is wrong for everything here except the one-off migration: the state
# audioctl writes belongs to the user whose session it is. Checked here rather
# than at the top of the file, because sourcing this as a library must not end
# in an exit.
if [ "$(id -un)" = root ] && [ "${1:-}" != migrate ]; then
    die "please run as the furios user, not as root - nothing here needs it (except 'audioctl migrate', once)."
fi

args=(); for a in "$@"; do [ "$a" = --dry-run ] && DRY=1 || args+=("$a"); done
set -- ${args+"${args[@]}"}
case "${1:-status}" in
    status) status ;;
    # Toggle: deliberately in test mode, so a reboot always leads back to the
    # shipped state.
    toggle) if [ "$(effective_profile)" = pw-hal ]; then
                switch_to standard sticky
            else
                switch_to pw-hal try
            fi ;;
    list)   printf '%s\n' $PROFILES ;;
    try)    [ $# -ge 2 ] || die "profile missing."; switch_to "$2" try ;;
    set)    [ $# -ge 2 ] || die "profile missing."; switch_to "$2" sticky ;;
    # What furios-audio-apply.service runs before the stack starts: drop the
    # test-mode marker, so a test profile never survives a reboot, and write
    # the configuration for the stored profile. Starts nothing - see uctl().
    # The test marker goes first, so current_profile() reads the STORED
    # profile below and not the one that must not survive a reboot.
    boot)   BOOT=1
            rm -f "$TRY"
            switch_to "$(current_profile)" boot ;;
    # And the other half, from furios-audio-verify.service: run after the
    # stack, when there is finally something to ask.
    boot-check) boot_check ;;
    # Restart without changing the profile - for instance so the HAL re-reads a
    # modified tuning file.
    restart) p=$(effective_profile)
             [ "$p" = unclear ] && p=$(current_profile)
             # apply() knows three profiles and silently does nothing for
             # anything else, so a stack that could not be identified used to
             # end in "no sink after the restart" with no hint as to why. And
             # the preconditions belong here as much as in a switch: restarting
             # into pw-hal without the plugin present is the same silent phone.
             known_profile "$p" || die "cannot tell which profile is running - try \"audioctl set standard\"."
             preflight "$p"
             printf 'restarting the audio stack (profile %s)\n' "$p"
             apply "$p"
             verify && info "OK - sink present: $(pactl list sinks short 2>/dev/null | awk '{print $2}' | paste -sd, -)" \
                    || printf 'WARNING: no sink after the restart.\n' >&2 ;;
    rescue) rescue ;;
    bt-call) [ $# -ge 2 ] || die "bt-call needs 'on', 'off' or 'watch'."; bt_call "$2" ;;
    bt-mic) [ $# -ge 2 ] || die "bt-mic needs 'on', 'off', 'test' or 'status'."; bt_mic "$2" "${3:-}" ;;
    revert) switch_to standard sticky ;;
    migrate) migrate_legacy ;;
    verify) verify && echo "OK - sink present." || { echo "no sink." >&2; exit 1; } ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
esac
