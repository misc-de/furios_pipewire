<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-FileCopyrightText: Copyright (c) 2026 misc-de
  SPDX-License-Identifier: MIT

  Switching the audio stack means masking system units and writing a systemd
  drop-in, which needs root. This is the authentication for it.

  allow_active is auth_self_keep: the person sitting in front of the phone
  types their own password, and polkit remembers it for a few minutes - a
  profile switch makes several privileged calls in a row and should ask once,
  not six times. Anyone not at the device has to be an administrator.
-->
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>furios_pipewire</vendor>
  <vendor_url>https://github.com/misc-de/furios_pipewire</vendor_url>

  <action id="de.furios.audioctl.configure">
    <description>Switch the audio stack</description>
    <description xml:lang="de">Audio-Stack umschalten</description>
    <message>Authentication is required to switch between PulseAudio and PipeWire</message>
    <message xml:lang="de">Zum Umschalten zwischen PulseAudio und PipeWire ist eine Authentifizierung nötig</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_self_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/furios-audio-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
